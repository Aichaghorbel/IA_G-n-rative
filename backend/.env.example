# ==============================================================================
# SMARTCAMPUS AI - BACKEND CONFIGURATION (.env)
# ==============================================================================

# Mode & Debug
ENVIRONMENT=development
DEBUG=True
APP_NAME="SmartCampus AI"
API_V1_STR="/api/v1"

# Base de données (PostgreSQL par défaut, fallback SQLite possible en local sans Docker)
DATABASE_URL=sqlite:///./smartcampus.db
# Pour PostgreSQL Docker :
# DATABASE_URL=postgresql+psycopg2://smartcampus:smartcampus_password@localhost:5432/smartcampus

# Redis (Optionnel en local, utilisé pour le rate limiting et sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# MinIO (Stockage documents RAG & audio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_SECURE=False
MINIO_BUCKET_DOCS=smartcampus-docs
MINIO_BUCKET_AUDIO=smartcampus-audio

# Sécurité & Tokens JWT
# Générer une clé robuste : openssl rand -hex 32
SECRET_KEY=smartcampus-super-secret-key-change-me-in-production-2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VISITOR_SESSION_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:8000"]

# IA & LLM (Qwen2.5 / OpenAI compatible / Ollama)
LLM_PROVIDER=openai_compatible
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen2.5-7b-instruct
WHISPER_MODEL=base

# Email SMTP (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=contact@smartcampus.tn
EMAILS_FROM_NAME=SmartCampus AI
