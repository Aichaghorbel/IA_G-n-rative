# ==============================================================================
# SMARTCAMPUS AI - ENVIRONNEMENT LOCAL (Variables globales et Docker)
# ==============================================================================

# Environnement (development | staging | production)
ENVIRONMENT=development
DEBUG=True

# --- PostgreSQL & pgvector ---
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://smartcampus:smartcampus_password@localhost:5432/smartcampus

# --- PGAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@smartcampus.tn
PGADMIN_DEFAULT_PASSWORD=admin_password_2026
PGADMIN_PORT=5050
PGADMIN_DEFAULT_PASSWORD_FILE=./pgadmin_password.txt

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_SECURE=False
MINIO_BUCKET_DOCS=smartcampus-docs
MINIO_BUCKET_AUDIO=smartcampus-audio

# --- Mailpit / SMTP ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=contact@smartcampus.tn
EMAILS_FROM_NAME=SmartCampus AI

# --- Sécurité & JWT ---
SECRET_KEY=smartcampus-super-secret-key-change-me-in-production-2026!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VISITOR_SESSION_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- Modèles d'IA & Services ---
LLM_PROVIDER=openai_compatible
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen2.5-7b-instruct
WHISPER_MODEL=base
EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend Angular ---
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
